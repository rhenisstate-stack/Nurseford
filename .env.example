# ==============================================================================
# RNENIS NURSING — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` and fill in the values, then restart the app.
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# ⚠️  BACKEND — REQUIRED (ask the backend developer for these)
# ------------------------------------------------------------------------------

# Which backend the frontend should talk to: "dotnet" | "laravel" | "fastapi"
SKEW_LINE_ACTIVE_BACKEND=

# .NET backend base URL (no trailing slash)
# Example: http://localhost:5000
SKEW_LINE_DOTNET_BASE_URL=

# Laravel backend base URL(s), comma-separated. The first entry is used.
# Example: http://localhost:8000
SKEW_LINE_LARAVEL_BASE_URL=

# FastAPI backend base URL(s), comma-separated. The SECOND entry is used.
# Example: http://localhost:8000,http://localhost:8001
SKEW_LINE_FASTAPI_BASE_URL=

# ------------------------------------------------------------------------------
# APP INFO — optional (sensible defaults already exist in code)
# ------------------------------------------------------------------------------
SKEW_LINE_API_BASE_URL=http://localhost:3000
SKEW_LINE_APP_NAME=Rhenis Nursing
SKEW_LINE_APP_TITLE=Rhenis Nursing
SKEW_LINE_APP_ACRONNYM=RN
SKEW_LINE_APP_DESCRIPTION=Nursing Exam Preparation and Practice Platform
SKEW_LINE_APP_VERSION=1.0.0
SKEW_LINE_APP_ENV=live
SKEW_LINE_APP_DEBUG=false
SKEW_LINE_APP_TIMEZONE=UTC
SKEW_LINE_APP_LOCALE=en
SKEW_LINE_APP_DOMAIN=http://localhost:3000

# ------------------------------------------------------------------------------
# CONTACT / SUPPORT — optional
# ------------------------------------------------------------------------------
SKEW_LINE_SUPPORT_EMAIL=support@rhenisnursing.com
SKEW_LINE_SYSTEM_EMAIL=support@rhenisnursing.com
SKEW_LINE_HELP_EMAIL=support@rhenisnursing.com

# ------------------------------------------------------------------------------
# PHONE NUMBERS — optional
# ------------------------------------------------------------------------------
SKEW_LINE_TELL_PHONE=
SKEW_LINE_SUPPORT_PHONE=
SKEW_LINE_HELP_PHONE=

# ------------------------------------------------------------------------------
# CONTACT & SOCIAL MEDIA — optional
# ------------------------------------------------------------------------------
SKEW_LINE_APP_AREA=
SKEW_LINE_APP_ADDRESS=
SKEW_LINE_APP_TELLUNO=
SKEW_LINE_APP_PHONEUNO=
SKEW_LINE_APP_TELTOS=
SKEW_LINE_APP_PHONETOS=
SKEW_LINE_APP_EMAILUNO=
SKEW_LINE_APP_EMAILTOS=
SKEW_LINE_APP_WHATSAPP=
SKEW_LINE_APP_INSTAGRAM=
SKEW_LINE_APP_FACEBOOK=
SKEW_LINE_APP_TWITTER=
SKEW_LINE_APP_LINKEDIN=
SKEW_LINE_APP_TELEGRAM=
SKEW_LINE_APP_TIKTOK=
SKEW_LINE_APP_REDDIT=
SKEW_LINE_APP_YOUTUBE=
SKEW_LINE_APP_PINTEREST=
SKEW_LINE_APP_WECHAT=
SKEW_LINE_APP_DISCORD=
SKEW_LINE_APP_GITHUB=
